      // Widget by se měl expandovat (animace)
      // Zde by šel testovat např. velikost nebo viditelnost dalších prvků
    },
  );

  patrolTest(
    'SongCard zobrazuje edit icon když isEditIconVisible=true',
    ($) async {
      final testSong = Song(
        id: '4',
        title: 'Editovatelná píseň',
        interpret: 'Edit Test',
        lyrics: 'Text...',
        bmp: 110,
