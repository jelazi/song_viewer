            ),
          ),
        ),
      );

      // Najdi SongCard a klikni na něj
      final songCard = $(SongCard);
      expect(songCard, findsOneWidget);
      
      await songCard.tap();
      await $.pumpAndSettle();

      // Po kliknutí se SongCard stále zobrazuje
      expect(songCard, findsOneWidget);
    },
  );

  patrolTest(
    'SongCard se expanduje při změně isExpanded',
    ($) async {
      final testSong = Song(
        id: '3',
        title: 'Expandující píseň',
        interpret: 'Expand Test',
        lyrics: 'Dlouhý text písně...',
        bmp: 90,
      );

      await $.pumpWidgetAndSettle(
        MaterialApp(
          home: _TestExpandableCard(
            song: testSong,
