                isSelectedSong: false,
                isEditIconVisible: false,
                isExpanded: false,
              ),
            ),
          ),
        ),
      );

      // SongCard by se měl zobrazovat
      expect($(SongCard), findsOneWidget);

      // Teď s edit ikonou
      await $.pumpWidgetAndSettle(
