                song: testSong,
                index: 0,
                isSelectedSong: false,
                isEditIconVisible: false,
                isExpanded: false,
              ),
            ),
          ),
        ),
      );

      // Assert - Ověř, že se komponenty zobrazují
      expect($(testSong.title), findsOneWidget);
      expect($(testSong.interpret!), findsOneWidget);
    },
  );

  patrolTest(
    'SongCard reaguje na tap',
    ($) async {
      final testSong = Song(
        id: '2',
        title: 'Klikatelná píseň',
        interpret: 'Test Interpret',
        lyrics: 'Text...',
        bmp: 100,
      );

      await $.pumpWidgetAndSettle(
        MaterialApp(
          home: Scaffold(
            body: BlocProvider(
              create: (context) => SettingsBloc(
                settingsRepository: mockSettingsRepository,
