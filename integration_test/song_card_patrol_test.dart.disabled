@GenerateMocks([SettingsRepository, SongsRepository])
import 'song_card_patrol_test.mocks.dart';

  setUp(() {
    mockSettingsRepository = MockSettingsRepository();
    mockSongsRepository = MockSongsRepository();
    
    // Nastav základní chování mock objektů
    when(mockSettingsRepository.typeClickCard).thenReturn(TypeClickCard.none);
  });

  patrolTest(
    'SongCard se zobrazí správně',
    ($) async {
      // Arrange - Vytvoř testovací data
      final testSong = Song(
        id: '1',
        title: 'Testovací píseň',
        interpret: 'Testovací interpret',
        lyrics: 'Text písně...',
        bmp: 120,
      );

      // Act - Vytvoř widget s základním BLoC setup
      await $.pumpWidgetAndSettle(
        MaterialApp(
          home: Scaffold(
            body: BlocProvider(
              create: (context) => SettingsBloc(
                settingsRepository: mockSettingsRepository,
                songsRepository: mockSongsRepository,
              ),
