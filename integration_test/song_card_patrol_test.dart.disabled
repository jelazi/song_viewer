/// Helper widget pro testování expandování
class _TestExpandableCard extends StatefulWidget {
  final Song song;
  final SettingsRepository settingsRepository;
  final SongsRepository songsRepository;

  const _TestExpandableCard({
    required this.song,
    required this.settingsRepository,
    required this.songsRepository,
  });

  @override
  State<_TestExpandableCard> createState() => _TestExpandableCardState();
}

class _TestExpandableCardState extends State<_TestExpandableCard> {
  bool isExpanded = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Column(
        children: [
          BlocProvider(
            create: (context) => SettingsBloc(
              settingsRepository: widget.settingsRepository,
              songsRepository: widget.songsRepository,
            ),
            child: SongCard(
              song: widget.song,
              index: 0,
              isSelectedSong: false,
              isEditIconVisible: false,
              isExpanded: isExpanded,
            ),
          ),
          ElevatedButton(
            onPressed: () {
              setState(() {
                isExpanded = !isExpanded;
              });
            },
            child: const Text('Expand'),
          ),
        ],
      ),
    );
  }
}

